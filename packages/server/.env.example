# Server Configuration
# Copy this file to .env and modify as needed

# HTTP server port (default: 3001)
PORT=3001

# Telnet server port (default: 4000)
TELNET_PORT=4000

# Allowed client origin for CORS (default: http://localhost:3000)
# Set this to your client URL in production
CLIENT_ORIGIN=http://localhost:3000

# AFK timeout in milliseconds (default: 900000 = 15 minutes)
AFK_TIMEOUT_MS=900000
