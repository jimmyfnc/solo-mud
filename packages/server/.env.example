# Server Configuration
# Copy this file to .env and modify as needed

# HTTP server port (default: 3001)
PORT=3001

# Telnet server port (default: 4000)
TELNET_PORT=4000

# Allowed client origin for CORS (default: http://localhost:3000)
# Set this to your client URL in production
CLIENT_ORIGIN=http://localhost:3000

# AFK timeout in milliseconds (default: 900000 = 15 minutes)
AFK_TIMEOUT_MS=900000

# Admin commands default to enabled outside production and disabled in production.
# Set explicitly when you need to override that behavior.
ENABLE_ADMIN_COMMANDS=true

# Input safety limits
MAX_COMMAND_LENGTH=500
MAX_TELNET_BUFFER_LENGTH=8192
